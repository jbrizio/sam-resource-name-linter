{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SAM Resource Name Linter Rules",
    "description": "Schema for defining naming rules in the SAM Resource Name Linter",
    "type": "object",
    "patternProperties": {
        "^AWS::[a-zA-Z0-9]+::[a-zA-Z0-9]+$": {
            "type": "object",
            "properties": {
                "propertyName": {
                    "type": "string",
                    "description": "Name of the property to be validated."
                },
                "pattern": {
                    "type": "string",
                    "description": "Regex pattern defining the full naming convention."
                },
                "excludedWords": {
                    "type": "array",
                    "description": "Words that should not appear in the name.",
                    "items": {
                        "type": "string"
                    }
                },
                "maxLength": {
                    "type": "integer",
                    "description": "Maximum length of the name."
                }
            },
            "required": [
                "pattern",
                "propertyName"
            ]
        }
    }
}